# Local Postgres (matches docker-compose.yml).
DATABASE_URL=postgres://stealth:stealth@localhost:5432/stealth

# Alpaca free "Basic" plan - options chains with IV and Greeks, 200 req/min.
# Create a free account at https://alpaca.markets (paper trading is fine;
# no funding required). Leave blank to run Yahoo-only, in which case Greeks
# are computed locally from Yahoo's implied volatility.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# FRED API key for the risk-free curve (free, https://fred.stlouisfed.org).
# Optional: without it the app falls back to a static short-rate constant,
# which affects Greeks only marginally.
FRED_API_KEY=
